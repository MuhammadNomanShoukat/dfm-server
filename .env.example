PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5151,http://127.0.0.1:5151
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dairy_farm
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME
PGDATABASE=dairy_farm
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=8h
MFA_TOKEN_EXPIRES_IN=2m
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
COOKIE_NAME=herdos_token

